rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAdmin() {
      return request.auth != null;
    }
    
    // Top 50 Rankings collection
    match /ranking/{rankingId} {
      allow read: if true;
      allow create: if request.resource.data.playerName is string
                    && request.resource.data.playerName.size() >= 1
                    && request.resource.data.playerName.size() <= 30
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0;
      allow update, delete: if isAdmin();
    }
    
    // Analytics Sessions collection
    match /analytics/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.sessionId is string
                            && request.resource.data.playerName is string
                            && request.resource.data.score is number;
      allow delete: if isAdmin();
    }
    
    // Record history
    match /recordHistory/{recordId} {
      allow read: if true;
      allow create: if request.resource.data.playerName is string
                    && request.resource.data.newScore is number;
      allow update, delete: if isAdmin();
    }
    
    // Sessions and visits
    match /sessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Meta / Stats
    match /meta/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
